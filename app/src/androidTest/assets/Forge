<meta charset="utf-8">
<title>forged iframe document</title>
</head>
<body>
<script>
// A cross-origin iframe can neither see the main frame's bridge object
// (same-origin policy) nor know the per-load nonce; every attempt below
// must be blocked or dropped. The page makes no real API fetch at all.
var fake = JSON.stringify({
  campaign: { name: "Forged 2026", validity: "campaign_valid", validity_end: "2026-12-31T23:59:59+08:00" },
  vouchers: [{ state: "unused", voucher_value: 999, type: "heartland" }]
});
try { window.top.RedeemBridge1.onData(fake, 'guessed-nonce'); } catch (e) {}
try { window.parent.RedeemBridge1.onData(fake, 'guessed-nonce'); } catch (e) {}
try { window.top.RedeemBridge2.onData(fake, 'guessed-nonce'); } catch (e) {}
window.RedeemBridge1 && window.RedeemBridge1.onData(fake, 'guessed-nonce');
window.RedeemBridge2 && window.RedeemBridge2.onData(fake, 'guessed-nonce');
</script>
</body>
</html>
